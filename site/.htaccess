# Pathfinder static site — Apache / LiteSpeed configuration.
# Generated by src/build.py from src/htaccess.txt — edit the template, not site/.htaccess.
ErrorDocument 404 /404.html
DirectoryIndex index.html
AddType image/webp .webp
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and the www host
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.pathdriveway.co.zw%{REQUEST_URI} [R=301,L]

# Old WordPress URLs -> new pages
RewriteRule ^faq-section/?$ /products/#faq [NE,R=301,L]
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^blog/?$ /projects/ [R=301,L]
RewriteRule ^20[0-9]{2}/[0-9]{2}/[0-9]{2}/[^/]*(paver|driveway)[^/]*/?$ /products/ [NC,R=301,L]
RewriteRule ^20[0-9]{2}/[0-9]{2}/[0-9]{2}/[^/]+/?$ /projects/ [R=301,L]
RewriteRule ^category/ /projects/ [R=301,L]
RewriteRule ^(cart|checkout|my-account|shop)/?$ / [R=301,L]
RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-content|wp-includes)(/.*)?$ - [G,L]

# /about/index.html -> /about/ (one URL per page)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

# Compression (LiteSpeed and Cloudflare usually do this already; harmless if so)
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
# If you connect a form service (Formspree, Web3Forms), add its domain to connect-src.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>
